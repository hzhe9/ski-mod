{
	"schemaVersion": 1,
	"id": "skis",
	"version": "${version}",
	"name": "Modern Skis",
	"description": "Alpine skis, a snowboard and a ski pole with real glide physics — carve down slopes, hold momentum, brake on your edges. 6 cosmetic styles, craftable from wood, leather and a few materials.",
	"authors": [
		"hzhe9"
	],
	"contact": {
		"sources": "https://github.com/hzhe9/ski-mod",
		"issues": "https://github.com/hzhe9/ski-mod/issues"
	},
	"license": "MIT",
	"icon": "assets/skis/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.hzhe9.skis.SkisMod"
		],
		"client": [
			"com.hzhe9.skis.client.SkisClient"
		]
	},
	"mixins": [
		{
			"config": "skis.mixins.json"
		},
		{
			"config": "skis.client.mixins.json",
			"environment": "client"
		},
		{
			"config": "skis.vivid_move.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
